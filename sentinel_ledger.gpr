with "config/sentinel_ledger_config.gpr";
with "sha3_ada.gpr";

project Sentinel_Ledger is

   for Source_Dirs use ("src/", "config/");

   for Object_Dir use
     "obj/" & Sentinel_Ledger_Config.Build_Profile;

   for Create_Missing_Dirs use "True";

   for Exec_Dir use "bin";

   for Main use ("sentinel_ledger.adb");

   package Compiler is

      for Default_Switches ("Ada") use
        Sentinel_Ledger_Config.Ada_Compiler_Switches
        & ("-gnat2022");

   end Compiler;

   package Binder is

      for Switches ("Ada") use
        ("-Es");

   end Binder;

   package Install is

      for Artifacts (".") use ("share");

   end Install;

end Sentinel_Ledger;